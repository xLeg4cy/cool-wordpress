# WordPress HTTP port exposed by Coolify. Optional; defaults to 8080.
WORDPRESS_PORT=8080

# WordPress database table prefix. Optional; keep the trailing underscore.
WORDPRESS_TABLE_PREFIX=wp_

# Required unique Redis object-cache namespace for this site.
WORDPRESS_CACHE_KEY_SALT=

# Required WordPress security keys and salts.
# Generate fresh values at: https://api.wordpress.org/secret-key/1.1/salt/
WORDPRESS_AUTH_KEY=
WORDPRESS_SECURE_AUTH_KEY=
WORDPRESS_LOGGED_IN_KEY=
WORDPRESS_NONCE_KEY=
WORDPRESS_AUTH_SALT=
WORDPRESS_SECURE_AUTH_SALT=
WORDPRESS_LOGGED_IN_SALT=
WORDPRESS_NONCE_SALT=

# Required MariaDB settings. Use strong unique passwords in Coolify.
MARIADB_DATABASE=wordpress
MARIADB_USER=wordpress
MARIADB_PASSWORD=
MARIADB_ROOT_PASSWORD=

# Required Redis password for production object caching.
REDIS_PASSWORD=

# Optional Masteriyo Pro social login credentials.
MASTERIYO_GOOGLE_CLIENT_ID=
MASTERIYO_GOOGLE_CLIENT_SECRET=
MASTERIYO_FACEBOOK_APP_ID=
MASTERIYO_FACEBOOK_APP_SECRET=
