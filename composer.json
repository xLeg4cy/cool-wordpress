{
    "name": "walkingfolks/cool-wordpress",
    "description": "Coolify Ready Wordpress Instance",
    "type": "project",
    "repositories": [
        {
            "name": "wpackagist",
            "type": "composer",
            "url": "https://wpackagist.org",
            "only": [
                "wpackagist-plugin/*",
                "wpackagist-theme/*"
            ]
        }
    ],
    "require": {
        "wpackagist-plugin/advanced-custom-fields": ">=6.7.1"
    },
    "require-dev": {
        "lipemat/wp-unit": "^4.8"
    },
    "config": {
        "allow-plugins": {
            "composer/installers": true
        }
    }
}